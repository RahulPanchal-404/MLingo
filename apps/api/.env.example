MLINGO_APP_NAME=MLingo API
MLINGO_APP_VERSION=0.1.0

# Environment: "development" or "production"
MLINGO_ENVIRONMENT=development

# Allowed frontend origin(s) for CORS (comma-separated if multiple, no trailing slash)
# In production: MLINGO_FRONTEND_ORIGIN=https://<your-deployed-frontend>.vercel.app
MLINGO_FRONTEND_ORIGIN=http://localhost:3000

# Server port (managed automatically by hosting platforms like Render via $PORT)
PORT=8000

# Optional persistence URL (inactive for V1 in-memory MVP)
MLINGO_DATABASE_URL=postgresql://mlingo:mlingo_dev_password@localhost:5432/mlingo
